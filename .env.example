# ============================================================
# ATSense — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the actual .env file to version control.
# ============================================================

# Server
PORT=5000
NODE_ENV= development
CLIENT_URL=http://localhost:5173

# Groq API
# Get your key at: https://console.groq.com
# NOTE: The free tier caps openai/gpt-oss-120b at 8,000 tokens/minute (TPM).
# The app auto-shrinks its prompt to fit, but avoid huge job descriptions.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Qdrant Cloud
# Get your cluster at: https://cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=

# RAG Configuration
TOP_K=5
