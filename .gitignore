# ============================================================
# ATSense — .gitignore
# ============================================================

# Environment — NEVER commit secrets
.env
.env.local
.env.production
.env.*.local

# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Build outputs
client/dist/
server/dist/

# Transformers.js model cache
server/.cache/
client/.cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# TypeScript
*.tsbuildinfo

# Misc
.npm
.eslintcache
.parcel-cache
